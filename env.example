# Kommo CRM Configuration
KOMMO_BASE_URL=https://seu-dominio.kommo.com
KOMMO_ACCESS_TOKEN=seu-token-de-acesso-aqui

# Server Configuration
PORT=3001
NODE_ENV=production

# Optional: Logging
LOG_LEVEL=info

# Optional: MCP Security
# MCP_HOST=127.0.0.1          # Default: 127.0.0.1 (local), set to 0.0.0.0 for remote/cloud
# MCP_ALLOWED_ORIGINS=https://claude.ai,https://console.anthropic.com
# MCP_AUTH_TOKEN=              # If set, requires Authorization: Bearer <token> or X-API-Key

# Optional: Kommo Status IDs (vary per account)
# KOMMO_WON_STATUS_ID=142     # ID of "Won" status in your Kommo pipelines
